{
  "description": "Mastersoft shared hooks: statusline wrapper install on SessionStart; load-brief, check_claude_md, load-catalog on UserPromptSubmit",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/install-statusline-wrapper.js" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/load-brief.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/check_claude_md.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/load-catalog.js" }
        ]
      }
    ]
  }
}
